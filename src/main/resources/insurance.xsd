<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="http://hospital.example/insurance"
           targetNamespace="http://hospital.example/insurance"
           elementFormDefault="qualified">

  <xs:element name="CheckEligibilityRequest">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="insuranceId" type="xs:string"/>
        <xs:element name="patientName" type="xs:string"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="CheckEligibilityResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="eligible" type="xs:boolean"/>
        <xs:element name="message" type="xs:string"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
